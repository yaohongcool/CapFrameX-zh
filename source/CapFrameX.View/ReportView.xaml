<UserControl x:Class="CapFrameX.View.ReportView"
			 Name="ReportViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"             
			 xmlns:dragdrop="urn:gong-wpf-dragdrop"
			 xmlns:prism="http://prismlibrary.com/"
			 xmlns:mvvm="clr-namespace:CapFrameX.MVVM.Converter;assembly=CapFrameX.MVVM"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CapFrameX.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
			 prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Styles/CxCards.xaml" />
			</ResourceDictionary.MergedDictionaries>
            <mvvm:BoolToVisibilityConverter x:Key="TrueToVisibleConverter" FalseValue="Collapsed" TrueValue="Visible"/>
			<mvvm:AddValueConverter x:Key="AddValueConverter" Offset="-75"/>
		</ResourceDictionary>
	</UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoReportItems, Converter={StaticResource TrueToVisibleConverter}}"  Grid.ZIndex="1">
            <TextBlock Text="将条目拖放到此处，或在记录列表中双击条目。" FontSize="18" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </Border>
        <StackPanel>
            <FrameworkElement x:Name="ColumnHeaders" Visibility="Collapsed"/>
            <DataGrid Grid.Row="0"
				  Margin="5 10 5 0"
				  AutoGenerateColumns="False"
				  AutoGeneratingColumn="OnAutoGeneratingColumn"
				  Tag="{Binding ElementName=ReportViewControl, Path=DataContext}" 
				  Name ="ReportDataGrid"
                  FontSize="15"
				  Height="{Binding ElementName=ReportViewControl, Path=ActualHeight, Converter={StaticResource AddValueConverter}}"
				  ItemsSource="{Binding ReportInfoCollection}" FocusVisualStyle="{x:Null}"
				  materialDesign:DataGridAssist.CellPadding="13 8 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8" IsSynchronizedWithCurrentItem="False"
				  CanUserSortColumns="True"
                  SelectionUnit="FullRow"
				  CanUserAddRows="False"
                  IsReadOnly="True"
                  LoadingRow="ReportDataGrid_LoadingRow"
                  Sorting="ReportDataGrid_Sorting"
				  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"
                  PreviewKeyDown="ReportDataGrid_PreviewKeyDown"
				  dragdrop:DragDrop.IsDropTarget="True"
				  dragdrop:DragDrop.IsDragSource="True"
				  dragdrop:DragDrop.DropHandler="{Binding}"
				  dragdrop:DragDrop.UseDefaultDragAdorner="True"
				  dragdrop:DragDrop.DropTargetAdornerBrush="White"
				  dragdrop:DragDrop.DefaultDragAdornerOpacity="0.5"
				  dragdrop:DragDrop.UseDefaultEffectDataTemplate="False"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
			<DataGrid.ContextMenu>
				<ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
					<MenuItem Header="复制表格" Command="{Binding CopyTableDataCommand}"/>
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Game, Mode=OneWay}"
                                            Header="游戏名称"
                                            Width="Auto"
                                            MinWidth="150"
                                            IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding Date, Mode=OneWay}"
                                            Header="创建日期"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCreationDate, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding Time, Mode=OneWay}"
                                            Header="创建时间"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCreationTime, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding NumberOfSamples, Mode=OneWay}"
                                            Header="样本数"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowNumberOfSamples, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding RecordTime, Mode=OneWay}"
                                            Header="记录时长 (s)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowRecordTime, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding Cpu, Mode=OneWay}"
                                            Header="CPU"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCpuName, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GraphicCard, Mode=OneWay}"
                                            Header="GPU"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuName, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding Ram, Mode=OneWay}"
                                            Header="RAM"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowRamName, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding CustomComment, Mode=OneWay}"
                                            Header="备注"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowComment, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding MaxFps, Mode=OneWay}"
                                            Header="最大 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowMaxFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding NinetyNinePercentQuantileFps, Mode=OneWay}"
                                            Header="P99 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP99FPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding NinetyFivePercentQuantileFps, Mode=OneWay}"
                                            Header="P95 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP95FS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding AverageFps, Mode=OneWay}"
                                            Header="平均 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowAverageFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding MedianFps, Mode=OneWay}"
                                            Header="中位数 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowMedianFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding FivePercentQuantileFps, Mode=OneWay}"
                                            Header="P5 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP5FPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding OnePercentQuantileFps, Mode=OneWay}"
                                            Header="P1 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP1FPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding OnePercentLowAverageFps, Mode=OneWay}"
                                            Header="1% 低值平均 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP1LowAverageFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding OnePercentLowIntegralFps, Mode=OneWay}"
                                            Header="1% 低值积分 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP1LowIntegralFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding ZeroDotTwoPercentQuantileFps, Mode=OneWay}"
                                            Header="P0.2 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP0Dot2FPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding ZeroDotOnePercentQuantileFps, Mode=OneWay}"
                                            Header="P0.1 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP0Dot1FPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding ZeroDotOnePercentLowAverageFps, Mode=OneWay}"
                                            Header="0.1% 低值平均 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP0Dot1LowAverageFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding ZeroDotOnePercentLowIntegralFps, Mode=OneWay}"
                                            Header="0.1% 低值积分 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowP0Dot1LowIntegralFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding MinFps, Mode=OneWay}"
                                            Header="最小 FPS"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowMinFPS, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding AnimationErrorP99, Mode=OneWay}"
                                            Header="P99 |动画误差| (ms)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowAnimationErrorP99, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding AnimationErrorAverage, Mode=OneWay}"
                                            Header="平均 |动画误差| (ms)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowAnimationErrorAverage, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding AdaptiveSTDFps, Mode=OneWay}"
                                            Header="自适应标准差"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowAdaptiveSTD, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding CpuFpsPerWatt, Mode=OneWay}"
                                            Header="CPU FPS / 10W"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCpuFpsPerWatt, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuFpsPerWatt, Mode=OneWay}"
                                            Header="GPU FPS / 10W"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuFpsPerWatt, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding AppLatency, Mode=OneWay}"
                                            Header="应用延迟 (ms)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowAppLatency, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuActiveTimeAverage, Mode=OneWay}"
                                            Header="GPU 忙碌平均 (ms)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuActiveTimeAverage, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuActiveTimeDeviation, Mode=OneWay}"
                                            Header="GPU 忙碌时间偏差 (%)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuActiveTimeDeviation, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding CpuMaxUsage, Mode=OneWay}"
                                            Header="CPU 最大线程 (%)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCpuMaxUsage, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding CpuPower, Mode=OneWay}"
                                            Header="CPU 功耗 (W)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCpuPower, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding CpuMaxClock, Mode=OneWay}"
                                            Header="CPU 时钟 (MHz)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCpuMaxClock, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding CpuTemp, Mode=OneWay}"
                                            Header="CPU 温度 (°C)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowCpuTemp, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuUsage, Mode=OneWay}"
                                            Header="GPU 使用率 (%)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuUsage, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuPower, Mode=OneWay}"
                                            Header="GPU 功耗 (W)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuPower, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuTBPSim, Mode=OneWay}"
                                            Header="GPU TBP Sim (W)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuTBPSim, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuClock, Mode=OneWay}"
                                            Header="GPU 时钟 (MHz)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuClock, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                    <DataGridTextColumn Binding="{Binding GpuTemp, Mode=OneWay}"
                                            Header="GPU 温度 (°C)"
                                            Width="Auto"
                                            IsReadOnly="True"
                                            Visibility="{Binding DataContext.ShowGpuTemp, Source={x:Reference ColumnHeaders}, Converter={StaticResource TrueToVisibleConverter}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <Border Grid.Row="1" Margin="5" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="20 0 10 0" VerticalAlignment="Center" Text="显示平均值行" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"></TextBlock>
                <ToggleButton VerticalAlignment="Center" IsChecked="{Binding ReportShowAverageRow}" ToolTip="显示包含全部已添加记录平均 FPS 指标的附加行。"/>
            </StackPanel>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="20 0 10 0" VerticalAlignment="Center" Text="使用 PMD 数值" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"></TextBlock>
                <ToggleButton VerticalAlignment="Center" IsChecked="{Binding ReportUsePMDValues}" ToolTip="如可用，使用 PMD 数值代替 Sensor 读数计算 CPU/GPU 功耗与能效。"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">指标设置：</TextBlock>
                <materialDesign:PopupBox VerticalAlignment="Center" StaysOpen="True" ToolTip="选择要显示的指标" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <materialDesign:Card Width="Auto" Margin="0 0 0 -10">
                        <Grid Margin="8 8 8 8">
                            <Grid.Resources>
                                <Style TargetType="CheckBox"
											BasedOn="{StaticResource MaterialDesignCheckBox}">
                                    <Setter Property="Margin" Value="8,8,10,8" />
                                </Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CxTextBox}">
                                    <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
                                    <Setter Property="Margin" Value="8,8,8,8" />
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="5" Grid.Row="0" Grid.Column="0" Text="创建日期" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowCreationDate}"/>
                            <TextBlock Margin="5" Grid.Row="1" Grid.Column="0" Text="创建时间" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowCreationTime}" />
                            <TextBlock Margin="5" Grid.Row="2" Grid.Column="0" Text="样本数" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowNumberOfSamples}"/>
                            <TextBlock Margin="5" Grid.Row="3" Grid.Column="0" Text="记录时长" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="3" Grid.Column="1" IsChecked="{Binding ShowRecordTime}"/>
                            <TextBlock Margin="5" Grid.Row="4" Grid.Column="0" Text="CPU 名称" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="4" Grid.Column="1" IsChecked="{Binding ShowCpuName}"/>
                            <TextBlock Margin="5" Grid.Row="5" Grid.Column="0" Text="GPU 名称" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="5" Grid.Column="1" IsChecked="{Binding ShowGpuName}"/>
                            <TextBlock Margin="5" Grid.Row="6" Grid.Column="0" Text="内存名称" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="6" Grid.Column="1" IsChecked="{Binding ShowRamName}"/>
                            <TextBlock Margin="5" Grid.Row="7" Grid.Column="0" Text="备注" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="7" Grid.Column="1" IsChecked="{Binding ShowComment}"/>
                            <TextBlock Margin="5" Grid.Row="0" Grid.Column="3" Text="最大值" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="0" Grid.Column="4" IsChecked="{Binding ShowMaxFPS}"/>
                            <TextBlock Margin="5" Grid.Row="1" Grid.Column="3" Text="99% 百分位" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="1" Grid.Column="4" IsChecked="{Binding ShowP99FPS}"/>
                            <TextBlock Margin="5" Grid.Row="2" Grid.Column="3" Text="95% 百分位" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="2" Grid.Column="4" IsChecked="{Binding ShowP95FS}" />
                            <TextBlock Margin="5" Grid.Row="3" Grid.Column="3" Text="平均值" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="3" Grid.Column="4" IsChecked="{Binding ShowAverageFPS}"/>
                            <TextBlock Margin="5" Grid.Row="4" Grid.Column="3" Text="中位数" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="4" Grid.Column="4" IsChecked="{Binding ShowMedianFPS}"/>
                            <TextBlock Margin="5" Grid.Row="5" Grid.Column="3" Text="5% 百分位" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="5" Grid.Column="4" IsChecked="{Binding ShowP5FPS}"/>
                            <TextBlock Margin="5" Grid.Row="6" Grid.Column="3" Text="1% 百分位" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="6" Grid.Column="4" IsChecked="{Binding ShowP1FPS}"/>
                            <TextBlock Margin="5" Grid.Row="7" Grid.Column="3" Text="0.2% 百分位" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="7" Grid.Column="4" IsChecked="{Binding ShowP0Dot2FPS}"/>
                            <TextBlock Margin="5" Grid.Row="8" Grid.Column="3" Text="0.1% 百分位" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="8" Grid.Column="4" IsChecked="{Binding ShowP0Dot1FPS}"/>
                            <TextBlock Margin="5" Grid.Row="9" Grid.Column="3" Text="1% 低值平均" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="9" Grid.Column="4" IsChecked="{Binding ShowP1LowAverageFPS}"/>
                            <TextBlock Margin="5" Grid.Row="0" Grid.Column="6" Text="0.1% 低值平均" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="0" Grid.Column="7" IsChecked="{Binding ShowP0Dot1LowAverageFPS}"/>
                            <TextBlock Margin="5" Grid.Row="1" Grid.Column="6" Text="1% 低值积分" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="1" Grid.Column="7" IsChecked="{Binding ShowP1LowIntegralFPS}"/>
                            <TextBlock Margin="5" Grid.Row="2" Grid.Column="6" Text="0.1% 低值积分" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="2" Grid.Column="7" IsChecked="{Binding ShowP0Dot1LowIntegralFPS}"/>
                            <TextBlock Margin="5" Grid.Row="3" Grid.Column="6" Text="最小值" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="3" Grid.Column="7" IsChecked="{Binding ShowMinFPS}"/>
                            <TextBlock Margin="5" Grid.Row="4" Grid.Column="6" Text="P99 |动画误差| (ms)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="4" Grid.Column="7" IsChecked="{Binding ShowAnimationErrorP99}"/>
                            <TextBlock Margin="5" Grid.Row="5" Grid.Column="6" Text="平均 |动画误差| (ms)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="5" Grid.Column="7" IsChecked="{Binding ShowAnimationErrorAverage}"/>
                            <TextBlock Margin="5" Grid.Row="6" Grid.Column="6" Text="自适应标准差" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="6" Grid.Column="7" IsChecked="{Binding ShowAdaptiveSTD}"/>
                            <TextBlock Margin="5" Grid.Row="7" Grid.Column="6" Text="CPU FPS/10W" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="7" Grid.Column="7" IsChecked="{Binding ShowCpuFpsPerWatt}"/>
                            <TextBlock Margin="5" Grid.Row="8" Grid.Column="6" Text="GPU FPS/10W" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="8" Grid.Column="7" IsChecked="{Binding ShowGpuFpsPerWatt}"/>
                            <!--<TextBlock Margin="5" Grid.Row="7" Grid.Column="6" Text="App latency (ms)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="7" Grid.Column="7" IsChecked="{Binding ShowAppLatency}"/>-->
                            <TextBlock Margin="5" Grid.Row="9" Grid.Column="6" Text="GPU 忙碌时间平均 (ms)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="9" Grid.Column="7" IsChecked="{Binding ShowGpuActiveTimeAverage}"/>
                            <TextBlock Margin="5" Grid.Row="10" Grid.Column="6" Text="GPU 忙碌时间偏差 (%)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="10" Grid.Column="7" IsChecked="{Binding ShowGpuActiveTimeDeviation}"/>
                            <TextBlock Margin="5" Grid.Row="0" Grid.Column="9" Text="CPU 最大线程 (%)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="0" Grid.Column="10" IsChecked="{Binding ShowCpuMaxUsage}"/>
                            <TextBlock Margin="5" Grid.Row="1" Grid.Column="9" Text="CPU 功耗 (W)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="1" Grid.Column="10" IsChecked="{Binding ShowCpuPower}"/>
                            <TextBlock Margin="5" Grid.Row="2" Grid.Column="9" Text="CPU 时钟 (MHz)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="2" Grid.Column="10" IsChecked="{Binding ShowCpuMaxClock}"/>
                            <TextBlock Margin="5" Grid.Row="3" Grid.Column="9" Text="CPU 温度 (°C)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="3" Grid.Column="10" IsChecked="{Binding ShowCpuTemp}"/>
                            <TextBlock Margin="5" Grid.Row="4" Grid.Column="9" Text="GPU 使用率 (%)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="4" Grid.Column="10" IsChecked="{Binding ShowGpuUsage}"/>
                            <TextBlock Margin="5" Grid.Row="5" Grid.Column="9" Text="GPU 功耗 (W)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="5" Grid.Column="10" IsChecked="{Binding ShowGpuPower}"/>
                            <TextBlock Margin="5" Grid.Row="6" Grid.Column="9" Text="GPU TBP Sim (W)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="6" Grid.Column="10" IsChecked="{Binding ShowGpuTBPSim}"/>
                            <TextBlock Margin="5" Grid.Row="7" Grid.Column="9" Text="GPU 时钟 (MHz)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="7" Grid.Column="10" IsChecked="{Binding ShowGpuClock}"/>
                            <TextBlock Margin="5" Grid.Row="8" Grid.Column="9" Text="GPU 温度 (°C)" VerticalAlignment="Center"/>
                            <ToggleButton Margin="5" Grid.Row="8" Grid.Column="10" IsChecked="{Binding ShowGpuTemp}"/>
                        </Grid>
                    </materialDesign:Card>
                </materialDesign:PopupBox>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource MaterialDesignFloatingActionMiniButton}"                
				Margin="0 0 20 0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Width="35" Height="35"
				ToolTip="移除全部报告条目"
                Foreground="White"
                BorderBrush="Transparent"
				Command="{Binding RemoveAllReportEntriesCommand}"
                Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}">
                <materialDesign:PackIcon Kind="PlaylistRemove" Height="25" Width="25" />
            </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
