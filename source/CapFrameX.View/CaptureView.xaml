<UserControl x:Class="CapFrameX.View.CaptureView"
			 x:Name="CaptureViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mvvm="clr-namespace:CapFrameX.MVVM.Converter;assembly=CapFrameX.MVVM"
             xmlns:validation ="clr-namespace:CapFrameX.MVVM.Validation;assembly=CapFrameX.MVVM"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
			 xmlns:prism="http://prismlibrary.com/"	
             xmlns:log="clr-namespace:CapFrameX.Data.Logging;assembly=CapFrameX.Data"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
             prism:ViewModelLocator.AutoWireViewModel="True">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Styles/CxCards.xaml" />
				<ResourceDictionary Source="Styles/CxTabHeaders.xaml" />
				<ResourceDictionary Source="Styles/CxVoiceSlider.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<mvvm:BoolToVisibilityConverter x:Key="FalseToCollapsedConverter" TrueValue="Visible" FalseValue="Collapsed"/>
			<mvvm:BoolToVisibilityConverter x:Key="FalseToVisibleConverter" TrueValue="Collapsed" FalseValue="Visible"/>
			<mvvm:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
			<Style x:Key="CxVoiceSlider" TargetType="{x:Type Slider}" BasedOn="{StaticResource MaterialDesign3.MaterialDesignSlider}">
				<Setter Property="Template" Value="{StaticResource CxVoiceSliderTemplate}" />
			</Style>

			<Style TargetType="ItemsControl" x:Key="LogViewerStyle">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate>
							<ScrollViewer CanContentScroll="True">
								<ItemsPresenter/>
							</ScrollViewer>
						</ControlTemplate>
					</Setter.Value>
				</Setter>

				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<VirtualizingStackPanel IsItemsHost="True"/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource CxTabHeaderItem}" />

			<!-- Log text the user can select and copy. WPF has no selectable TextBlock, so a
			     read-only TextBox takes over. The stripped-down template is what keeps it looking
			     like the TextBlock it replaces: MaterialDesign3.Defaults is merged application
			     wide and styles every TextBox implicitly, which would otherwise add an underline,
			     padding and a floating hint. Both scrollbars stay Disabled so the inner
			     ScrollViewer never swallows the mouse wheel — the log list scrolls instead. -->
			<Style TargetType="{x:Type TextBox}" x:Key="SelectableLogTextStyle">
				<Setter Property="IsReadOnly" Value="True"/>
				<Setter Property="IsTabStop" Value="False"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Padding" Value="0"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
				<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
				<Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TextBox}">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="False"
								HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<DataTemplate DataType="{x:Type log:LogEntry}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"></RowDefinition>
						<RowDefinition Height="Auto"></RowDefinition>
					</Grid.RowDefinitions>

					<TextBox Text="{Binding MessageInfo, Mode=OneWay}" Grid.Row="0" Grid.Column="0" Style="{StaticResource SelectableLogTextStyle}"
                       FontWeight="Bold" FontSize="11"  Margin="5,3,5,0"/>

					<TextBox Text="{Binding Message, Mode=OneWay}" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SelectableLogTextStyle}"
                       TextWrapping="Wrap" FontSize="13"  Margin="5,0,5,5"/>
				</Grid>
			</DataTemplate>

			<!--<DataTemplate DataType="{x:Type log:CollapsibleLogEntry}">
                <Grid IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Date" Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding MessageInfo}" Grid.Column="0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                       FontWeight="Bold" FontSize="11"  Margin="5,3,5,0"/>

                    <TextBlock Text="{Binding Message}" Grid.Column="2" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                       TextWrapping="Wrap" FontSize="11"  Margin="5,0,5,5"/>

                    <ToggleButton x:Name="Expander" Grid.Row="1" Grid.Column="0"
                          VerticalAlignment="Top" Content="+" HorizontalAlignment="Right"/>

                    <ItemsControl ItemsSource="{Binding Contents}" Style="{StaticResource LogViewerStyle}"
                          Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          x:Name="Contents" Visibility="Collapsed"/>

                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Expander" Property="IsChecked" Value="True">
                        <Setter TargetName="Contents" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Expander" Property="Content" Value="-"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>-->
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid VerticalAlignment="Top" HorizontalAlignment="Center">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="5*"></ColumnDefinition>
				<ColumnDefinition Width="4*"></ColumnDefinition>
			</Grid.ColumnDefinitions>
			<!-- Top margin aligns the process cards with the first card of the
			     run-history tab on the right (tab strip height + card margin). -->
			<DockPanel Grid.Column="0" Margin="10 50 0 0">
				<Grid DockPanel.Dock="Top" HorizontalAlignment="Center">
					<Grid HorizontalAlignment="Center">
						<DockPanel>
							<Grid DockPanel.Dock="Top">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<!--Running processes card-->
								<Border Style="{StaticResource SectionCard}" Grid.Column="0" Width="264" Margin="0 0 12 0" Padding="16 12 16 16">
									<StackPanel>
										<DockPanel LastChildFill="False">
											<materialDesign:PackIcon Kind="ApplicationOutline" Width="20" Height="20" VerticalAlignment="Center"
												Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
											<TextBlock Text="运行中的进程" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="8 0 0 0"
												Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
											<Button DockPanel.Dock="Right" VerticalAlignment="Center" Width="26" Height="26" Padding="0"
												Style="{StaticResource MaterialDesignIconButton}" ToolTip="重置并重新扫描进程"
												Command="{Binding ResetPresentMonCommand}" IsEnabled="{Binding AreButtonsActive}"
												Foreground="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}">
												<materialDesign:PackIcon Kind="Autorenew" Width="20" Height="20"/>
											</Button>
										</DockPanel>
										<Border Margin="0 12 0 0" Style="{StaticResource SectionCardInset}" Padding="0 4 6 4">
											<ListView IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding ProcessesToCapture}" SelectedItem="{Binding SelectedProcessToCapture}"
												ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="14" ScrollViewer.CanContentScroll="True" Height="160"
												IsEnabled="{Binding AreButtonsActive}">
												<ListView.ContextMenu>
													<ContextMenu>
														<MenuItem Header="显示进程详情"
														Command="{Binding ShowProcessDetailsCommand}" />
													</ContextMenu>
												</ListView.ContextMenu>
											</ListView>
										</Border>
										<Button Margin="0 12 0 0" HorizontalAlignment="Right" BorderThickness="0" Height="34" Padding="12 0"
											Command="{Binding AddToIgonreListCommand}" IsEnabled="{Binding AreButtonsActive}" Foreground="White"
											Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" Content="移入忽略列表"/>
									</StackPanel>
								</Border>
								<!--Process ignore list card-->
								<Border Style="{StaticResource SectionCard}" Grid.Column="1" Width="264" Margin="12 0 0 0" Padding="16 12 16 16">
									<StackPanel>
										<DockPanel LastChildFill="False" Height="26">
											<materialDesign:PackIcon Kind="EyeOffOutline" Width="20" Height="20" VerticalAlignment="Center"
												Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
											<TextBlock Text="进程忽略列表" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="8 0 0 0"
												Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
										</DockPanel>
										<Border Margin="0 12 0 0" Style="{StaticResource SectionCardInset}" Padding="0 4 6 4">
											<ListView IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding ProcessesToIgnore}" SelectedItem="{Binding SelectedProcessToIgnore}"
												ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="14" ScrollViewer.CanContentScroll="True" Height="160">
											</ListView>
										</Border>
										<Button Margin="0 12 0 0" HorizontalAlignment="Right" BorderThickness="0" Height="34" Padding="12 0"
											Command="{Binding AddToProcessListCommand}" IsEnabled="{Binding AreButtonsActive}" Foreground="White"
											Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" Content="从忽略列表移除"/>
									</StackPanel>
								</Border>
							</Grid>
							<TextBlock DockPanel.Dock="Bottom" Grid.Column="0" Grid.ColumnSpan="2" TextAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Margin="0 20 0 0" Text="{Binding CaptureStateInfo}" HorizontalAlignment="Center" FontSize="16" Style="{StaticResource MaterialDesignCaptionTextBlock}" />
						</DockPanel>
					</Grid>
				</Grid>
				<Border Style="{StaticResource SectionCard}" Margin="0 24 0 0" Padding="16 12 16 16" DockPanel.Dock="Bottom" HorizontalAlignment="Center">
				<StackPanel>
					<DockPanel LastChildFill="False">
						<materialDesign:PackIcon Kind="Tune" Width="20" Height="20" VerticalAlignment="Center"
							Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
						<TextBlock Text="捕获设置" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="8 0 0 0"
							Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
					</DockPanel>
					<Grid x:Name="HotkeyTextBox" Margin="0 8 0 0" HorizontalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="45"/>
						<RowDefinition Height="45"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>
					<TextBox Grid.Row="0" Grid.Column="0" Width="110" wpf:HintAssist.Hint="捕获热键" Style="{DynamicResource CxFloatingHintTextBox}"
						 Margin="0" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" wpf:HintAssist.HintOpacity=".8"
						 IsUndoEnabled="False" PreviewKeyDown="CaptureHotkeyTextBox_PreviewKeyDown"
						 ContextMenu="{x:Null}" InputMethod.IsInputMethodEnabled="False"
						 ToolTip="热键可组合最多两个修饰键（Ctrl、Shift 或 Alt）。按 Backspace、Delete 或 Esc 清除。">
						<!-- Deliberately not IsReadOnly: the MaterialDesign 5.x read-only text-field
						     styling indents the text against the floating hint. All keyboard input is
						     swallowed by the PreviewKeyDown hotkey capture; paste and IME input are
						     disabled via ContextMenu/InputMethod. -->
						<Binding Path="CaptureHotkey"
							  ElementName="CaptureViewControl"
							  Mode="OneWay"
							  TargetNullValue="{x:Static validation:HotkeyValidationRule.UnsetText}">
							<Binding.ValidationRules>
								<validation:HotkeyValidationRule ValidatesOnTargetUpdated="True" />
							</Binding.ValidationRules>
						</Binding>
					</TextBox>

					<TextBox x:Name="CaptureTimeTextBox" Grid.Row="0" Grid.Column="1" Width="110" wpf:HintAssist.Hint="捕获时长 [秒]" Style="{DynamicResource CxFloatingHintTextBox}"
						 Margin="30 0 0 0" FontSize="14" Text="{Binding CaptureTimeString, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreButtonsActive}"
						 PreviewKeyDown="CaptureTimeTextBox_PreviewKeyDown" LostKeyboardFocus="CaptureTimeTextBox_LostKeyboardFocus"
						 TextChanged="CaptureTimeTextBox_TextChanged" ToolTip="0 = 无限制。按回车或离开输入框保存。"
						 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" wpf:HintAssist.HintOpacity=".8"/>
					<Button x:Name="CaptureTimeScopeButton" Grid.Row="1" Grid.Column="1" Margin="26 3 0 0" Padding="4 0"
						 HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" MinWidth="0" FontSize="11"
						 IsEnabled="{Binding AreButtonsActive}" ToolTip="{Binding CaptureTimeScopeToolTip}"
						 AutomationProperties.Name="Capture duration scope" Click="CaptureTimeScopeButton_Click"
						 ContextMenuOpening="CaptureTimeScopeButton_ContextMenuOpening">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
								<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
								<Setter Property="Opacity" Value="0.7"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasGameCaptureTime}" Value="True">
										<Setter Property="FontWeight" Value="Medium"/>
										<Setter Property="Opacity" Value="1"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding CaptureTimeScopeLabel}" VerticalAlignment="Center"/>
							<materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Margin="3 0 0 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
						</StackPanel>
						<Button.ContextMenu>
							<ContextMenu Placement="Bottom" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
								<MenuItem Header="{Binding CaptureTimeProcessLabel}" IsEnabled="False" FontSize="11"/>
								<Separator/>
								<MenuItem Height="Auto" MinHeight="56" IsCheckable="True" IsChecked="{Binding UseGlobalCaptureTime, Mode=OneWay}" Command="{Binding UseGlobalCaptureTimeCommand}">
									<MenuItem.Header>
										<StackPanel MaxWidth="300">
											<TextBlock Text="使用全局时长" FontSize="13"/>
											<TextBlock Text="{Binding GlobalCaptureTimeDescription}" FontSize="11" Opacity="0.7" Margin="0 4 0 0" TextWrapping="Wrap"/>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<MenuItem Height="Auto" MinHeight="56" IsCheckable="True" IsChecked="{Binding HasGameCaptureTime, Mode=OneWay}" Command="{Binding RememberGameCaptureTimeCommand}" Click="RememberGameCaptureTime_Click">
									<MenuItem.Header>
										<StackPanel MaxWidth="300">
											<TextBlock Text="记住此游戏的时长" FontSize="13"/>
											<TextBlock Text="{Binding GameCaptureTimeDescription}" FontSize="11" Opacity="0.7" Margin="0 4 0 0" TextWrapping="Wrap"/>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
							</ContextMenu>
						</Button.ContextMenu>
					</Button>

					<TextBox Grid.Row="0" Grid.Column="2" Width="110" wpf:HintAssist.Hint="捕获延迟 [秒]" Style="{DynamicResource CxFloatingHintTextBox}"
					 Margin="30 0 0 0" FontSize="14" Text="{Binding CaptureDelayString, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreButtonsActive}"
                     PreviewMouseDown="TextBox_PreviewMouseDown" PreviewKeyDown="TextBox_PreviewKeyDown" MouseLeave="TextBox_MouseLeave" ToolTip="0 = 无延迟"
                     PreviewTextInput="NumberValidationTextBox" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" wpf:HintAssist.HintOpacity=".8"/>

					<!--MDIX floats a ComboBox hint ~2px left of the field, where its first letter gets cut.
					    The explicit offset keeps MDIX's height and aligns it with the TextBox hints beside it.-->
					<ComboBox Grid.Row="0" Grid.Column="3" Width="102" Height="40" materialDesign:HintAssist.Hint="热键提示音" Style="{StaticResource CxComboBox}"
						  Margin="30 0 0 0" MaxDropDownHeight="200" FontSize="14" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.HintOpacity=".8"
						  materialDesign:HintAssist.FloatingOffset="0,-14"
						  ItemsSource="{Binding SoundModes}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Bottom" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
						<ComboBox.Text>
							<Binding Path="SelectedSoundMode"
								 Mode="TwoWay"
								 UpdateSourceTrigger="PropertyChanged">
							</Binding>
						</ComboBox.Text>
					</ComboBox>

					<Grid Grid.Row="1" Grid.Column="3" Margin="20 10 -5 0" Width="110" Height="26" Visibility="{Binding ShowVolumeController, Converter={StaticResource FalseToCollapsedConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="18" />
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="22" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="VolumeMedium" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
						<Slider Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CxVoiceSlider}"
							Minimum="0" 
							Maximum="100" 
							ToolTip="音量控制"
							Value="{Binding SliderSoundLevel}"
							Width="65" Thumb.DragCompleted="Slider_DragCompleted" />
						<TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding SliderSoundLevel}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
					</Grid>
				</Grid>
				</StackPanel>
			</Border>
			</DockPanel>
			<TabControl Grid.Column="1" Margin="20 14 20 20" Background="Transparent" BorderThickness="0">
				<TabItem Width="192" Margin="8 0 6 0" Header="运行历史与聚合">
					<StackPanel Width="400" Margin="{StaticResource CxTabContentMargin}">
						<!--Run history card-->
						<Border Style="{StaticResource SectionCard}" Margin="0 0 0 4" Padding="16 12 16 16">
							<StackPanel>
								<DockPanel LastChildFill="False">
									<materialDesign:PackIcon Kind="History" Width="20" Height="20" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
									<TextBlock Text="运行历史" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="8 0 0 0"
										Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
									<ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding UseRunHistory}"
										ToolTipService.ShowDuration="25000">
										<ToggleButton.ToolTip>
											<ToolTip MaxWidth="250">
												<TextBlock Text="将指定数量的运行保存到历史记录，也可在 Overlay 上显示"
													TextWrapping="Wrap"/>
											</ToolTip>
										</ToggleButton.ToolTip>
									</ToggleButton>
								</DockPanel>
								<Grid IsEnabled="{Binding UseRunHistory}" Margin="0 12 0 0">
									<Grid.Resources>
										<Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource CxComboBox}">
											<Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
											<Setter Property="materialDesign:HintAssist.HintOpacity" Value=".8"/>
											<Setter Property="Margin" Value="0 10 0 10"/>
										</Style>
									</Grid.Resources>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="24"/>
										<ColumnDefinition Width="1*"/>
									</Grid.ColumnDefinitions>
									<ComboBox Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="历史保留轮数"
										MaxDropDownHeight="100" ItemsSource="{Binding Path=NumberOfRunsItemsSource}" ToolTipService.ShowDuration="25000">
										<ComboBox.ToolTip>
											<ToolTip StaysOpen="True" MaxWidth="275">
												<TextBlock Text="写入历史的运行数量。不使用聚合时，历史存满后新运行将替换最旧的一条。"
													TextWrapping="Wrap"/>
											</ToolTip>
										</ComboBox.ToolTip>
										<ComboBox.Text>
											<Binding Path="SelectedNumberOfRuns"
											         Mode="TwoWay"
											         UpdateSourceTrigger="PropertyChanged">
											</Binding>
										</ComboBox.Text>
									</ComboBox>
									<!--Reset run history hotkey. Deliberately not IsReadOnly: the MaterialDesign 5.x
									    read-only text-field styling indents the text against the floating hint. All
									    keyboard input is swallowed by the PreviewKeyDown hotkey capture; paste and
									    IME input are disabled via ContextMenu/InputMethod. -->
									<TextBox Grid.Row="0" Grid.Column="2" Margin="0 10 0 10" materialDesign:HintAssist.Hint="重置运行历史"
										Style="{DynamicResource CxFloatingHintTextBox}" FontSize="14"
										IsUndoEnabled="False" PreviewKeyDown="ResetHistoryHotkeyTextBox_PreviewKeyDown"
										ContextMenu="{x:Null}" InputMethod.IsInputMethodEnabled="False"
										ToolTip="热键可组合最多两个修饰键（Ctrl、Shift 或 Alt）。按 Backspace、Delete 或 Esc 清除。" materialDesign:HintAssist.HintOpacity=".8">
										<Binding Path="ResetHistoryHotkey"
										 ElementName="CaptureViewControl"
										 Mode="OneWay"
										 TargetNullValue="{x:Static validation:HotkeyValidationRule.UnsetText}">
											<Binding.ValidationRules>
												<validation:HotkeyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox>
									<ComboBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="第二指标"
										MaxDropDownHeight="330" ItemsSource="{Binding SecondMetricItems}" SelectedItem="{Binding SelectedSecondMetric}"
										ToolTip="在 Overlay 上为历史条目显示的第二指标">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<ComboBox Grid.Row="1" Grid.Column="2" materialDesign:HintAssist.Hint="第三指标"
										MaxDropDownHeight="360" ItemsSource="{Binding ThirdMetricItems}" SelectedItem="{Binding SelectedThirdMetric}"
										ToolTip="在 Overlay 上为历史条目显示的第三指标">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</Grid>
							</StackPanel>
						</Border>
						<!--Aggregation card-->
						<Border Style="{StaticResource SectionCard}" Margin="0 8 0 8" Padding="16 12 16 16">
							<StackPanel>
								<DockPanel LastChildFill="False">
									<materialDesign:PackIcon Kind="Sigma" Width="20" Height="20" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
									<TextBlock Text="运行历史聚合" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="8 0 0 0"
										Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
									<ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding UseAggregation}"
										IsEnabled="{Binding AggregationButtonEnabled}"
										ToolTipService.ShowDuration="25000">
										<ToggleButton.ToolTip>
											<ToolTip MaxWidth="350">
												<TextBlock Text="运行历史存满后，将所有帧时间数据合并保存为一条新记录。&#10;&#10;这不同于对多个记录文件求平均参数。它模拟同一场景连续运行多次的一次基准测试，所有帧时间数据只计算一次性能参数。"
													TextWrapping="Wrap"/>
											</ToolTip>
										</ToggleButton.ToolTip>
									</ToggleButton>
								</DockPanel>
								<Grid IsEnabled="{Binding UseAggregation}" Margin="0 12 0 0">
									<Grid.Resources>
										<Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource CxComboBox}">
											<Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
											<Setter Property="materialDesign:HintAssist.HintOpacity" Value=".8"/>
											<Setter Property="Margin" Value="0 10 0 10"/>
										</Style>
									</Grid.Resources>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="24"/>
										<ColumnDefinition Width="1*"/>
									</Grid.ColumnDefinitions>
									<ComboBox Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="离群值处理"
										MaxDropDownHeight="100" ItemsSource="{Binding OutlierHandlingItems}" SelectedItem="{Binding SelectedOutlierHandling}"
										ToolTipService.ShowDuration="25000">
										<ComboBox.ToolTip>
											<ToolTip MaxWidth="350">
												<TextBlock
                                                Text="若某轮所选指标与全部运行的中位数差异超过设定百分比，将被标记为离群值。&#10;&#10;标记并使用：历史存满即聚合所有运行。&#10;&#10;标记并替换：被标记的运行需用额外运行替换，直到历史中无离群值再聚合。"
													TextWrapping="Wrap"/>
											</ToolTip>
										</ComboBox.ToolTip>
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<ComboBox Grid.Row="0" Grid.Column="2" materialDesign:HintAssist.Hint="离群值指标"
										MaxDropDownHeight="100" ItemsSource="{Binding RelatedMetricItemsSource}" SelectedItem="{Binding SelectedRelatedMetric}"
										ToolTipService.ShowDuration="25000">
										<ComboBox.ToolTip>
											<ToolTip MaxWidth="350">
												<TextBlock Text="用于判定离群值的指标" TextWrapping="Wrap"/>
											</ToolTip>
										</ComboBox.ToolTip>
									</ComboBox>
									<ComboBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="离群值百分比"
										MaxDropDownHeight="200" ItemsSource="{Binding OutlierPercentageItemsSource}" SelectedItem="{Binding SelectedOutlierPercentage}"
										ToolTipService.ShowDuration="25000">
										<ComboBox.ToolTip>
											<ToolTip MaxWidth="350">
												<TextBlock Text="单轮 FPS 与全部运行中位数的最大允许差异百分比，超出即记为离群值"
													TextWrapping="Wrap"/>
											</ToolTip>
										</ComboBox.ToolTip>
									</ComboBox>
									<CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0 12 0 4"
										IsChecked="{Binding SaveAggregationOnly}" ToolTipService.ShowDuration="25000">
										<CheckBox.ToolTip>
											<ToolTip StaysOpen="True" MaxWidth="275">
												<TextBlock Text="若勾选，除聚合结果外不再单独保存各轮数据。"
													TextWrapping="Wrap"/>
											</ToolTip>
										</CheckBox.ToolTip>
										<TextBlock Padding="5 0 0 0" TextWrapping="WrapWithOverflow">
											仅保存聚合结果
										</TextBlock>
									</CheckBox>
								</Grid>
							</StackPanel>
						</Border>
					</StackPanel>
				</TabItem>
				<TabItem Width="120" Header="捕获日志">
					<StackPanel Width="400" Margin="{StaticResource CxTabContentMargin}">
						<Border Style="{StaticResource SectionCard}" Height="415" VerticalAlignment="Top">
						<Grid>
							<TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Text="捕获服务日志输出..." FontSize="14" Margin="10 10 0 0" 
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Visibility="{Binding IsLoggerOutputEmpty, Converter={StaticResource FalseToCollapsedConverter}}"></TextBlock>
							<ItemsControl ItemsSource="{Binding LoggerOutput}" Style="{StaticResource LogViewerStyle}">
								<ItemsControl.Template>
									<ControlTemplate>
										<ScrollViewer ScrollChanged="ScrollViewer_ScrollChanged" CanContentScroll="True">
											<ItemsPresenter/>
										</ScrollViewer>
									</ControlTemplate>
								</ItemsControl.Template>
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel IsItemsHost="True"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</ItemsControl>
							</Grid>
						</Border>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Height="50">
							<Button HorizontalAlignment="Left" Margin="0 0 10 0" Width="25" Height="25" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
                                    materialDesign:RippleAssist.Feedback="#DD000000" 
                                    Command="{Binding ClearLogCommand}" 
                                    Foreground="White"
                                    Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" 
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}">
								<materialDesign:PackIcon Kind="PlaylistRemove"  Height="20" Width="20" />
								<Button.ToolTip>
									<ToolTip>
										<TextBlock Text="清空日志输出">
										</TextBlock>
									</ToolTip>
								</Button.ToolTip>
							</Button>
							<StackPanel Margin="25 0 0 0" Orientation="Horizontal">
								<TextBlock Text="消息筛选" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
								<materialDesign:PopupBox StaysOpen="True" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
									<materialDesign:Card  Margin="0 0 0 -10">
										<StackPanel>
											<Grid Margin="8 8 8 8">
												<Grid.RowDefinitions>
													<RowDefinition Height="30" />
													<RowDefinition Height="30" />
													<RowDefinition Height="30" />
												</Grid.RowDefinitions>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="30"/>
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Row="0" Grid.Column="0" Text="基本信息"></TextBlock>
												<TextBlock Grid.Row="1" Grid.Column="0" Text="详细信息"></TextBlock>
												<TextBlock Grid.Row="2" Grid.Column="0" Text="错误"></TextBlock>

												<CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding ShowBasicInfo}"></CheckBox>
												<CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding ShowAdvancedInfo}"></CheckBox>
												<CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding ShowErrors}"></CheckBox>
											</Grid>
										</StackPanel>
									</materialDesign:Card>
								</materialDesign:PopupBox>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</TabItem>
			</TabControl>
		</Grid>
	</Grid>
</UserControl>
